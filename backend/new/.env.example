PORT=3000

# Comma-separated browser origins for CORS (GitHub Pages + local). Leave empty to allow all (dev).
# Example: https://your-org.github.io,http://localhost:8081,http://localhost:19006
ALLOWED_ORIGINS=

# PostgreSQL (LGS team credentials — put real password in local .env only)
POSTGRES_USER=LGS_Tech
POSTGRES_PASSWORD=REPLACE_WITH_TEAM_PASSWORD
POSTGRES_DB=lgs_tech
DATABASE_URL=postgresql://LGS_Tech:REPLACE_WITH_TEAM_PASSWORD@localhost:5432/lgs_tech
