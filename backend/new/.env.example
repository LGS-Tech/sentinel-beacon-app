PORT=3000

# PostgreSQL (required — team credentials in backend chat; do not commit real .env)
POSTGRES_USER=LGS_Tech
POSTGRES_PASSWORD=REPLACE_WITH_TEAM_PASSWORD
POSTGRES_DB=lgs_tech
DATABASE_URL=postgresql://LGS_Tech:REPLACE_WITH_TEAM_PASSWORD@localhost:5432/lgs_tech

# Auth (required for /auth/login signup; set a long random string)
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Set true on production once all clients send Bearer tokens
REQUIRE_AUTH=false

# Comma-separated browser origins for CORS (GitHub Pages + local)
ALLOWED_ORIGINS=

# Cloudflare R2 — set on the server only. Never expose these to the app.
# Create an R2 bucket + API token with Object Read & Write, then paste here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional override (defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
